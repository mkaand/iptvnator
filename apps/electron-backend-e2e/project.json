{
    "name": "electron-backend-e2e",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/electron-backend-e2e/src",
    "implicitDependencies": [
        "electron-backend",
        "stalker-mock-server",
        "xtream-mock-server"
    ],
    "targets": {
        "e2e": {
            "dependsOn": ["electron-backend:build-e2e"]
        },
        "test-performance-harness": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "tsx --test \"src/performance/*.spec.ts\""
            }
        },
        "benchmark-m3u-refresh-cancellation": {
            "dependsOn": ["electron-backend:build-performance"],
            "executor": "nx:run-commands",
            "cache": false,
            "parallelism": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "playwright test --config=playwright.performance.config.ts src/m3u-refresh-cancellation.performance.ts"
            }
        },
        "benchmark-m3u-import": {
            "dependsOn": ["electron-backend:build-performance"],
            "executor": "nx:run-commands",
            "cache": false,
            "parallelism": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "playwright test --config=playwright.performance.config.ts src/m3u-import.performance.ts"
            }
        },
        "benchmark-xtream": {
            "dependsOn": ["electron-backend:build-performance"],
            "executor": "nx:run-commands",
            "cache": false,
            "parallelism": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "playwright test --config=playwright.xtream-performance.config.ts src/xtream.performance.ts"
            }
        },
        "benchmark-charset-parse": {
            "executor": "nx:run-commands",
            "cache": false,
            "parallelism": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "tsx --expose-gc --tsconfig tsconfig.json src/performance/charset-parse.benchmark.ts"
            }
        },
        "benchmark-m3u-global-search": {
            "executor": "nx:run-commands",
            "cache": false,
            "parallelism": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "tsx --tsconfig tsconfig.json src/performance/m3u-global-search.benchmark.ts"
            }
        },
        "benchmark-m3u-global-search-sql": {
            "executor": "nx:run-commands",
            "cache": false,
            "parallelism": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "tsx --tsconfig tsconfig.json src/performance/m3u-global-search-sql.benchmark.ts"
            }
        },
        "benchmark-m3u-global-search-phase4": {
            "executor": "nx:run-commands",
            "cache": false,
            "parallelism": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "tsx --tsconfig tsconfig.json src/performance/m3u-global-search-phase4.benchmark.ts"
            }
        },
        "benchmark-m3u-global-search-phase5": {
            "executor": "nx:run-commands",
            "cache": false,
            "parallelism": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "tsx --tsconfig tsconfig.json src/performance/m3u-global-search-phase5.benchmark.ts"
            }
        },
        "phase5-packaged-acceptance": {
            "executor": "nx:run-commands",
            "cache": false,
            "parallelism": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "tsx --tsconfig tsconfig.json src/performance/phase5-packaged-acceptance.ts compare"
            }
        },
        "phase5b-packaged-functional-acceptance": {
            "executor": "nx:run-commands",
            "cache": false,
            "parallelism": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "tsx --tsconfig tsconfig.json src/performance/phase5b-packaged-functional-acceptance.ts compare"
            }
        },
        "journeys": {
            "dependsOn": ["electron-backend:build-performance"],
            "executor": "nx:run-commands",
            "cache": false,
            "parallelism": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "playwright test --config=playwright.journeys.config.ts"
            }
        },
        "journeys-large-library": {
            "dependsOn": ["electron-backend:build-performance"],
            "executor": "nx:run-commands",
            "cache": false,
            "parallelism": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "env": {
                    "IPTVNATOR_JOURNEY_LARGE_LIBRARY": "1"
                },
                "command": "playwright test --config=playwright.journeys.config.ts src/journeys/launch-large.journey.ts"
            }
        },
        "large-library-profile": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "tsx --tsconfig tsconfig.json src/performance/large-library-profile.cli.ts"
            }
        },
        "compositing-report": {
            "dependsOn": ["electron-backend:build-e2e"],
            "executor": "nx:run-commands",
            "cache": false,
            "parallelism": false,
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "playwright test --config=playwright.compositing.config.ts"
            }
        },
        "packaged-frame-copy-smoke": {
            "dependsOn": ["test-packaged-frame-copy-fixtures"],
            "executor": "nx:run-commands",
            "cache": false,
            "outputs": [
                "{workspaceRoot}/dist/playwright-report/electron-backend-e2e/packaged-frame-copy-smoke",
                "{workspaceRoot}/dist/test-results/electron-backend-e2e/packaged-frame-copy-smoke"
            ],
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "playwright test --config=playwright.packaged.config.ts src/embedded-mpv-frame-copy-packaged.e2e.ts"
            }
        },
        "test-packaged-frame-copy-fixtures": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/electron-backend-e2e",
                "command": "tsx --test src/embedded-mpv-frame-copy-packaged-fixtures.spec.ts"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        }
    },
    "tags": ["scope:e2e", "domain:electron-main", "type:e2e"]
}
